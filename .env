# ============================================
# ArcDoc Enterprise - Environment Configuration
# ============================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arcdoc

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Argon2
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ArcDoc Enterprise
NEXT_PUBLIC_COMPANY_NAME=ArcDoc

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@arcdoc.ro
SMTP_PASS=change-this
SMTP_FROM=noreply@arcdoc.ro
SMTP_SECURE=false

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Vercel
VERCEL_ENV=development

# AI Provider
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096
AI_API_KEY=
