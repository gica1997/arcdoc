# ArcDoc Enterprise - Environment Variables Template
# Copy this file to .env and fill in the values

DATABASE_URL=postgresql://user:password@host:5432/arcdoc
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ArcDoc Enterprise
NEXT_PUBLIC_COMPANY_NAME=ArcDoc
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@arcdoc.ro
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@arcdoc.ro
SMTP_SECURE=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
VERCEL_ENV=development