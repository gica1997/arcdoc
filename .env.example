# ArcDoc Enterprise - Environment Variables Template
# Copy this file to .env and fill in the values

# Database (Turso/SQLite or PostgreSQL)
DATABASE_URL=libsql://your-database.turso.io
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT Authentication
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Argon2 Password Hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ArcDoc Enterprise
NEXT_PUBLIC_COMPANY_NAME=ArcDoc
VERCEL_ENV=development

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@arcdoc.ro
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@arcdoc.ro
SMTP_SECURE=false

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# AI Provider
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096
AI_API_KEY=
